{
  "name": "ccunified",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "worker",
    "dashboard"
  ],
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "build": "npm run build -w dashboard && npm run build -w worker"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
